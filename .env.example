# Browser client config used by the Vite web app
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Edge function secrets used by local Supabase functions
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# AI Integrations
OPENROUTER_API_KEY="your-openrouter-key-here"


# Monetization
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Optional local development port overrides (read by npm run dev)
# WEB_PORT=3000
# CATALOG_PORT=3100
# CATALOG_DB_PORT=54328
# CATALOG_REDIS_PORT=6380
