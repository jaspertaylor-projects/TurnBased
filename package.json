{
  "name": "turnbased",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:local": "./scripts/dev-local.sh",
    "dev": "npm run dev:local",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:catalog": "node scripts/dev-local.mjs --catalog-only",
    "dev:stop": "node scripts/dev-local.mjs --stop",
    "test:dev": "node --test scripts/dev/*.test.mjs",
    "test:catalog": "npm run test:e2e --workspace @turnbased/catalog-api",
    "test:workshop": "tsx --test apps/web/src/editor/cardStudio/*.test.ts apps/web/src/editor/playtest/*.test.ts apps/web/src/editor/templateStudio/*.test.ts apps/web/src/editor/componentStudio/*.test.ts",
    "test:versions": "vitest run --config scripts/vitest.versions.config.ts",
    "test:workshop:browser": "node scripts/check-workshop-browser.mjs",
    "test:components:browser": "node scripts/check-component-templates-browser.mjs",
    "test:rules:api": "tsx --test supabase/functions/ai-rules-writer/*.test.ts",
    "test:rules:browser": "node scripts/check-rules-fixes-browser.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "supabase": "2.107.0",
    "tsx": "^4.23.13",
    "vitest": "^3.2.4"
  }
}
